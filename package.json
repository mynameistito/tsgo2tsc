{
  "name": "tsgo2tsc",
  "version": "0.0.1",
  "description": "Migrate projects from @typescript/native-preview and tsgo to the TypeScript 7 tsc flow.",
  "keywords": [
    "cli",
    "migration",
    "native-preview",
    "tsc",
    "tsgo",
    "typescript"
  ],
  "homepage": "https://github.com/mynameistito/tsgo2tsc#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/tsgo2tsc/issues"
  },
  "license": "MIT",
  "author": "mynameistito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/tsgo2tsc.git"
  },
  "bin": {
    "tsgo2tsc": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "changeset": "changeset",
    "changeset-add": "bun run ./scripts/add-changeset.ts",
    "dev": "bun src/cli.ts",
    "release": "bun run ./scripts/publish.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "commander": "^14.0.0",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.0",
    "jsonc-parser": "^3.3.0",
    "magic-string": "^0.30.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsdown": "^0.22.0",
    "typescript": "^7.0.0",
    "ultracite": "7.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14"
}
